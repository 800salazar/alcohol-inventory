# Copia este archivo a `.env.local` y completa con los valores de tu proyecto Supabase.
# Settings → API en el dashboard de Supabase.

# URL del proyecto (ej: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clave pública "anon" (segura para el cliente; la seguridad real la imponen las RLS Policies)
VITE_SUPABASE_ANON_KEY=

# SECURITY NOTES:
# - Nunca pongas `SUPABASE_SERVICE_ROLE_KEY` en archivos de entorno usados por el frontend.
#   Esa clave da privilegios totales y debe almacenarse solo en el servidor (Edge Functions, CI, secrets de despliegue).
# - Para funciones/servidor: usa `supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...` o configura el secreto en tu proveedor de despliegue.
# - Este archivo es plantilla; copia a `.env.local` y completa los valores necesarios.
